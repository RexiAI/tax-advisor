# Everything in this file is a placeholder. Copy it to `.env.local` and fill in
# real values there. `.env.local` is gitignored; this example never is.
#
# The single configuration module `src/config/env.ts` is the only place these
# variables are read. A missing LLM variable is a configuration error: the chat
# route answers 503 and no model call is attempted. There is no default model,
# no default base URL and no fallback answer.

# Base URL of the OpenAI-compatible endpoint, e.g. https://<host>/v1 .
LLM_BASE_URL=

# API key for that endpoint. Never commit a real value.
LLM_API_KEY=

# Model id to request from that endpoint.
LLM_MODEL=

# Optional provider extension: set to "true" to send
# {"thinking":{"type":"disabled"}} and skip chain-of-thought tokens.
LLM_DISABLE_REASONING=

# Tax year the committed corpus covers.
CORPUS_TAX_YEAR=

# Minimum top retrieval score for an evidence bundle to count as sufficient.
MIN_RETRIEVAL_SCORE=

# Number of passages retrieved per query.
RETRIEVAL_TOP_K=

# Maximum accepted chat message length, in characters.
MAX_MESSAGE_CHARS=

# Maximum chat requests allowed per client IP inside one fixed window.
RATE_LIMIT_MAX=

# Fixed rate-limit window length, in milliseconds.
RATE_LIMIT_WINDOW_MS=

# Upper bound on a single model call, in milliseconds.
LLM_TIMEOUT_MS=
